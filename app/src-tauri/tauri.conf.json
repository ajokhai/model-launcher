{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Launcher",
  "version": "0.1.0",
  "identifier": "com.ajokhai.modellauncher",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Model Launcher",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Launch open-source models on your Mac",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
